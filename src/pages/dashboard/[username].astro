---
import { listMonitorsForUser, type Monitor } from '../../../supabase/db/monitors';
import DeleteDialog from '../../components/DeleteDialog.astro';
import EmptyState from '../../components/EmptyState.astro';
import MonitorCard from '../../components/MonitorCard.astro';
import MonitorForm from '../../components/MonitorForm.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const username = (Astro.params.username ?? '').trim().toLowerCase();
const valid = /^[a-z0-9_-]{3,10}$/.test(username);
const monitors: Monitor[] = valid ? await listMonitorsForUser(username) : [];
---

<Layout title={`${username || 'Dashboard'} — Uptime Monitor`}>
	<main class="container dashboard">
		<div class="dashboard-top">
			<header class="page-head">
				<a class="back-link" href="/">← change user</a>
				<h1 class="username">@{username}</h1>
			</header>

			{valid && (
				<div class="toolbar">
					<p class="muted mono-comment">{monitors.length} monitor{monitors.length === 1 ? '' : 's'} · active</p>
					<button class="btn btn-primary" type="button" data-action="create">+ add monitor</button>
				</div>
			)}
		</div>

		{!valid ? (
			<p class="muted">
				That username can't be used — 3–10 chars of letters, numbers, <code>_</code> or <code>-</code>.{' '}
				<a href="/">Go back</a> and try another.
			</p>
		) : monitors.length === 0 ? (
			<EmptyState>
				<button class="btn btn-primary" type="button" data-action="create">+ add your first monitor</button>
			</EmptyState>
		) : (
			<ul class="monitor-list" tabindex="0" aria-label="Monitors" data-lenis-prevent>
				{monitors.map((monitor, index) => (
					<MonitorCard monitor={monitor} delay={index * 45} />
				))}
			</ul>
		)}

		<MonitorForm username={username} />
		<DeleteDialog />
	</main>
</Layout>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('#monitor-dialog');
	const form = document.querySelector<HTMLFormElement>('#monitor-form');
	const errorEl = document.querySelector<HTMLParagraphElement>('#monitor-form-error');
	const idEl = document.querySelector<HTMLInputElement>('#monitor-id');
	const usernameEl = document.querySelector<HTMLInputElement>('#monitor-username');
	const nameEl = document.querySelector<HTMLInputElement>('#monitor-name');
	const urlEl = document.querySelector<HTMLInputElement>('#monitor-url');
	const intervalEl = document.querySelector<HTMLSelectElement>('#monitor-interval');
	const timeoutEl = document.querySelector<HTMLSelectElement>('#monitor-timeout');
	const submitBtn = document.querySelector<HTMLButtonElement>('#monitor-submit');
	const dashboardTop = document.querySelector<HTMLDivElement>('.dashboard-top');
	const monitorList = document.querySelector<HTMLUListElement>('.monitor-list');

	// Cards scroll in their own full-width scroller (scrollbar outside at the
	// viewport edge), so forward wheel/touch over the fixed top to the list.
	if (dashboardTop && monitorList) {
		dashboardTop.addEventListener('wheel', (event: WheelEvent) => {
			event.preventDefault();
			monitorList.scrollTop += event.deltaY;
		}, { passive: false });

		let touchY: number | null = null;
		dashboardTop.addEventListener('touchstart', (event: TouchEvent) => {
			touchY = event.touches[0]?.clientY ?? null;
		}, { passive: true });
		dashboardTop.addEventListener('touchmove', (event: TouchEvent) => {
			const y = event.touches[0]?.clientY;
			if (touchY == null || y == null) return;
			event.preventDefault();
			monitorList.scrollTop += touchY - y;
			touchY = y;
		}, { passive: false });
	}

	declare global {
		interface Window {
			showToast: (message: string, kind?: 'info' | 'success' | 'error') => void;
		}
	}

	function showError(message: string): void {
		if (!errorEl) return;
		errorEl.textContent = message;
		errorEl.hidden = false;
	}

	function clearError(): void {
		if (!errorEl) return;
		errorEl.textContent = '';
		errorEl.hidden = true;
	}

	function resetForm(): void {
		form?.reset();
		if (idEl) idEl.value = '';
		clearError();
	}

	function setLoading(btn: HTMLButtonElement | null, loading: boolean): void {
		if (!btn) return;
		btn.disabled = loading;
		btn.querySelector<HTMLSpanElement>('.spinner')?.toggleAttribute('hidden', !loading);
		btn.querySelector<HTMLSpanElement>('.btn-label')?.toggleAttribute('hidden', loading);
	}

	document.querySelectorAll<HTMLButtonElement>('[data-action="create"]').forEach((btn) => {
		btn.addEventListener('click', () => {
			resetForm();
			if (intervalEl) intervalEl.value = '10';
			if (timeoutEl) timeoutEl.value = '10';
			dialog?.showModal();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-action="edit"]').forEach((btn) => {
		btn.addEventListener('click', () => {
			resetForm();
			const data = btn.dataset;
			if (idEl) idEl.value = String(data.monitorId ?? '');
			if (nameEl) nameEl.value = data.name ?? '';
			if (urlEl) urlEl.value = data.url ?? '';
			if (intervalEl) intervalEl.value = String(data.intervalMinutes ?? '');
			if (timeoutEl) timeoutEl.value = String(data.timeoutSeconds ?? '');
			dialog?.showModal();
		});
	});

	type ApiError = { error?: { message?: string } };

	function errorMessage(body: unknown, fallback: string): string {
		if (body != null && typeof body === 'object' && 'error' in body) {
			return (body as ApiError).error?.message ?? fallback;
		}
		return fallback;
	}

	document.querySelectorAll<HTMLButtonElement>('[data-action="cancel-dialog"]').forEach((btn) => {
		btn.addEventListener('click', () => dialog?.close());
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		clearError();

		const name = (nameEl?.value ?? '').trim();
		const rawUrl = (urlEl?.value ?? '').trim();
		if (!name) {
			showError('give your monitor a name.');
			return;
		}
		if (name.length > 80) {
			showError('keep the name under 80 chars.');
			return;
		}
		if (!rawUrl) {
			showError('paste the URL you want watched.');
			return;
		}
		let scheme = '';
		try {
			scheme = new URL(rawUrl).protocol;
		} catch {
			scheme = '';
		}
		if (scheme !== 'http:' && scheme !== 'https:') {
			showError('that URL doesn’t look right — include https://');
			return;
		}

		const id = idEl?.value ?? '';
		const payload: Record<string, string | number> = {
			name,
			url: rawUrl,
			intervalMinutes: Number(intervalEl?.value ?? 10),
			timeoutSeconds: Number(timeoutEl?.value ?? 10),
		};
		if (!id) {
			payload.username = usernameEl?.value ?? '';
		}

		setLoading(submitBtn, true);
		const response = await fetch(id ? `/api/monitors/${id}` : '/api/monitors', {
			method: id ? 'PATCH' : 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(payload),
		});

		if (response.ok) {
			window.showToast(id ? 'Monitor updated' : 'Monitor created', 'success');
			location.reload();
			return;
		}

		setLoading(submitBtn, false);
		const body: unknown = await response.json().catch(() => null);
		showError(errorMessage(body, 'Something went wrong, please try again.'));
	});

	document.querySelectorAll<HTMLButtonElement>('[data-action="toggle-pause"]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const id = btn.dataset.monitorId;
			if (!id) return;
			const paused = btn.dataset.paused === 'true';
			setLoading(btn, true);

			const response = await fetch(`/api/monitors/${id}`, {
				method: 'PATCH',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ isPaused: !paused }),
			});

			if (response.ok) {
				window.showToast(paused ? 'Monitor resumed' : 'Monitor paused', 'success');
				location.reload();
				return;
			}
			setLoading(btn, false);
			window.showToast('Failed to update monitor.', 'error');
		});
	});

	const deleteDialog = document.querySelector<HTMLDialogElement>('#delete-dialog');
	const deleteForm = document.querySelector<HTMLFormElement>('#delete-form');
	const deleteNameEl = document.querySelector<HTMLSpanElement>('#delete-dialog .delete-name');
	const deleteConfirmBtn = document.querySelector<HTMLButtonElement>('#delete-confirm');
	let deleteId = '';

	document.querySelectorAll<HTMLButtonElement>('[data-action="delete"]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.dataset.monitorId;
			if (!id) return;
			deleteId = id;
			if (deleteNameEl) deleteNameEl.textContent = btn.dataset.name ?? '';
			if (deleteForm) deleteForm.reset();
			deleteDialog?.showModal();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-action="cancel-delete"]').forEach((btn) => {
		btn.addEventListener('click', () => deleteDialog?.close());
	});

	deleteForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!deleteId) return;

		setLoading(deleteConfirmBtn, true);
		const response = await fetch(`/api/monitors/${deleteId}`, { method: 'DELETE' });

		if (response.ok) {
			window.showToast('Monitor deleted', 'success');
			deleteDialog?.close();
			location.reload();
			return;
		}
		setLoading(deleteConfirmBtn, false);
		window.showToast('Failed to delete monitor.', 'error');
	});
</script>