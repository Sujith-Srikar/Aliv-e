---
interface Props {
  name?: string;
}

const { name = '' } = Astro.props;
---

<dialog id="delete-dialog" aria-labelledby="delete-dialog-title" data-lenis-prevent>
	<form id="delete-form" class="dialog-body delete-body" method="dialog">
		<h2 id="delete-dialog-title">Delete monitor</h2>
		<p class="muted delete-copy">
			This permanently deletes <span class="delete-name mono-comment">{name}</span> and cannot be
			undone.
		</p>

		<div class="form-actions">
			<button class="btn" type="button" data-action="cancel-delete">Cancel</button>
			<button class="btn btn-danger-solid" type="submit" id="delete-confirm">
				<span class="spinner" hidden></span>
				<span class="btn-label">Delete</span>
			</button>
		</div>
	</form>
</dialog>
